rules_version = '2';
// NBA Tahmin — güvenlik kuralları
// - Herkes yalnızca kendi tahminini yazar; gecenin ilk maçı başlayınca bütün tahminler kilitlenir.
// - Bir tahmin, kilide kadar yalnızca sahibine görünür; sonra herkese açılır.
// - Oyuna katılmak için davet kodu gerekir (config/secret içinde, kimse okuyamaz).
// - Tahminlerdeki updatedAt alanı sunucu saatine eşit olmak zorunda; puanlama
//   betiği bu saatle gerçek maç saatini ayrıca karşılaştırır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isPlayer() { return signedIn() && exists(/databases/$(database)/documents/players/$(request.auth.uid)); }
    function str(v, maxLen) { return v is string && v.size() > 0 && v.size() <= maxLen; }
    // Tahminler kilit saatinde kapanır ve o an herkese açılır. Site, tahminin "start"
    // alanına gecenin ilk maçının saatini yazar; puanlama betiği bunu ESPN'den ayrıca doğrular.
    function lockAt(t) { return t; }
    // Yönetici: config/admin belgesindeki uids listesinde olanlar (Firebase konsolundan eklenir)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admin)
        && request.auth.uid in get(/databases/$(database)/documents/config/admin).data.uids;
    }
    // Oyuncu adı: büyük harfle başlar; harf, rakam, boşluk ve . - ' içerebilir; küfür/hakaret içermez.
    // (Ayrıntılı kontrol sitede yapılır; burada en bariz kelimeler engellenir.)
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 40
        && n.matches('^\\p{Lu}[\\p{L}\\p{N} .\'-]*$')
        && !n.lower().matches('.*(orospu|orosbu|siktir|sikerim|sikeyim|sikik|yarrak|dalyarak|am[iı]nak|amc[iı]k|ibne|pezevenk|kahpe|kaltak|yav[sş]ak|[sş]erefsiz|fuck|shit|bitch|cunt|nigg|faggot|whore|asshole).*');
    }

    function profileOk(d) {
      return (!('color' in d) || d.color in ['p0', 'p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8', 'p9'])
        && (!('emoji' in d) || d.emoji in ['', '🏀', '🔥', '🐐', '👑', '🦅', '🐺', '🦁', '🐻', '🐍', '🦈', '⚡', '🌪️', '🎯', '💎', '🚀', '🧊', '☄️', '🌙', '⭐', '🍀', '🎲', '🛡️', '🥷', '🤖'])
        && (!('favTeam' in d) || (d.favTeam is string && d.favTeam.size() <= 5))
        && (!('theme' in d) || d.theme in ['default', 'team'])
        // av: avatar görseli. '' ya da 't:LAL' (takım logosu) ya da 'p:1234567' (oyuncu fotoğrafı)
        && (!('av' in d) || (d.av is string && d.av.matches('^(t:[A-Z]{2,4}|p:[0-9]{3,10})?$')));
    }

    match /config/{doc} {
      allow read, write: if false;
    }
    // Davet kodunu yalnızca yönetici görür ve değiştirir
    match /config/secret {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['invite'])
        && str(request.resource.data.invite, 40);
    }

    // league/settings: ligin başladığı gece ve geçmiş ligler. Herkes okur, yönetici yazar.
    match /league/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // banned/{uid}: ligden çıkarılan oyuncular (tekrar katılamaz). Yönetici yönetir.
    match /banned/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Davet kodunu doğrulayan kayıt; okunamaz.
    match /joins/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['invite'])
        && request.resource.data.invite == get(/databases/$(database)/documents/config/secret).data.invite;
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && existsAfter(/databases/$(database)/documents/joins/$(uid))
        && !exists(/databases/$(database)/documents/banned/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'joined'])
        && validName(request.resource.data.name)
        && request.resource.data.joined == request.time;
      // Profil: ad, renk, emoji, favori takım ve tema değiştirilebilir (listeden seçilir)
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'emoji', 'favTeam', 'theme', 'av'])
        && (!('name' in request.resource.data.diff(resource.data).affectedKeys()) || validName(request.resource.data.name))
        && profileOk(request.resource.data);
      allow delete: if isAdmin();
      // yönetici, ligden çıkardığı oyuncuyu eski adı ve katılma saatiyle geri alabilir
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['name', 'joined'])
        && str(request.resource.data.name, 40) && request.resource.data.joined is timestamp;
    }

    // picks/{maçId}_{uid}
    match /picks/{pid} {
      // Olmayan belgeyi okumak serbest (bilgi sızdırmaz); var olan belge sahibine
      // ya da kilitlendikten sonra (gecenin ilk maçı başlayınca) herkese açık.
      allow read: if resource == null
        || (signedIn() && resource.data.uid == request.auth.uid)
        || request.time >= lockAt(resource.data.start);

      function validPick() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'gameId', 'day', 'start', 'winner', 'margin', 'scorerId', 'scorerName', 'updatedAt'])
          && d.uid == request.auth.uid
          && pid == d.gameId + '_' + request.auth.uid
          && str(d.gameId, 20) && str(d.day, 8)
          && d.start is timestamp
          && str(d.winner, 6)
          && d.margin in ['1-5', '6-10', '11-15', '16+']
          && str(d.scorerId, 20) && str(d.scorerName, 60)
          && d.updatedAt == request.time
          && request.time < lockAt(d.start);
      }
      allow create: if isPlayer() && validPick();
      allow update: if isPlayer() && validPick()
        && resource.data.uid == request.auth.uid
        && request.resource.data.start == resource.data.start
        && request.time < lockAt(resource.data.start);
      allow delete: if false;
    }

    // daily/{gün}_{uid}: günün güveni ve günün oyuncusu
    match /daily/{did} {
      allow read: if resource == null
        || (signedIn() && resource.data.uid == request.auth.uid)
        || request.time >= lockAt(resource.data.firstStart);

      function baseOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'day', 'firstStart', 'confGame', 'confStart', 'confAt', 'dayPlayerId', 'dayPlayerName', 'dayAt', 'q', 'qAt'])
          && d.uid == request.auth.uid
          && did == d.day + '_' + request.auth.uid
          && d.firstStart is timestamp;
      }
      function confOk(old) {
        let d = request.resource.data;
        return !('confGame' in d) || (
          (old != null && 'confGame' in old && d.confGame == old.confGame && d.confAt == old.confAt && d.confStart == old.confStart)
          || (str(d.confGame, 20) && d.confStart is timestamp && request.time < lockAt(d.confStart)
              && d.confAt == request.time
              && (old == null || !('confStart' in old) || request.time < lockAt(old.confStart)))
        );
      }
      function dayOk(old) {
        let d = request.resource.data;
        return !('dayPlayerId' in d) || (
          (old != null && 'dayPlayerId' in old && d.dayPlayerId == old.dayPlayerId && d.dayAt == old.dayAt)
          || (str(d.dayPlayerId, 20) && str(d.dayPlayerName, 60)
              && d.dayAt == request.time && request.time < lockAt(d.firstStart))
        );
      }
      // gecenin sorusu: evet (y) / hayır (n), ilk maça kadar değiştirilebilir
      function qOk(old) {
        let d = request.resource.data;
        return !('q' in d) || (
          (old != null && 'q' in old && d.q == old.q && d.qAt == old.qAt)
          || (d.q in ['y', 'n'] && d.qAt == request.time && request.time < lockAt(d.firstStart))
        );
      }
      allow create: if isPlayer() && baseOk() && confOk(null) && dayOk(null) && qOk(null);
      allow update: if isPlayer() && baseOk()
        && resource.data.uid == request.auth.uid
        && request.resource.data.firstStart == resource.data.firstStart
        && confOk(resource.data) && dayOk(resource.data) && qOk(resource.data);
      allow delete: if false;
    }

    // progress/{gün}_{uid}: hangi maçlara tahmin girildiği (seçimler değil). Herkese açık,
    // böylece "Mustafa 5/7 maç girdi" gösterilebilir.
    match /progress/{did} {
      allow read: if true;
      allow write: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'day', 'gids', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && did == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.gids is list && request.resource.data.gids.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }

    // recovery/{uid}: güvenlik sorusunun (takım + oyuncu) tuzlu SHA-256 özeti.
    // Yalnızca sahibi yazar ve okur; şifre sıfırlamayı GitHub'daki görev (yönetici yetkisiyle) yapar.
    match /recovery/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['salt', 'h', 'setAt'])
        && request.resource.data.salt is string && request.resource.data.salt.size() == 32
        && request.resource.data.h is string && request.resource.data.h.size() == 64
        && request.resource.data.setAt == request.time;
      allow delete: if false;
    }

    // resets/{id}: "şifremi unuttum" isteği. Girişsiz oluşturulur, kimse okuyamaz;
    // GitHub görevi birkaç dakikada bir işler ve siler.
    match /resets/{id} {
      allow read, update, delete: if false;
      allow create: if id.size() >= 16 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'team', 'playerId', 'pin', 'at'])
        && str(request.resource.data.name, 40)
        && str(request.resource.data.team, 6)
        && str(request.resource.data.playerId, 20)
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{6}$')
        && request.resource.data.at == request.time;
    }

    // resetStatus/{id}: isteğin sonucu (ok / wrong / locked / nouser / nosetup). İsteği atan, kimliğini bildiği için okur.
    match /resetStatus/{id} {
      allow read: if true;
      allow write: if false;
    }

    // contacts/{uid}: hatırlatma maili için e-posta. Yalnızca sahibi okur ve yazar;
    // GitHub'daki görev yönetici yetkisiyle okur. "verified" ancak mailine gelen kod doğruysa true olur.
    function otpOk(d, uid) {
      let path = /databases/$(database)/documents/otp/$(uid);
      return exists(path) && d.code is string && d.code.size() == 6
        && get(path).data.email == d.email
        && request.time < get(path).data.exp
        && hashing.sha256(get(path).data.salt + d.code) == get(path).data.h;
    }
    match /contacts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'remind', 'weekly', 'verified', 'code', 'updatedAt'])
        && (!('weekly' in request.resource.data) || request.resource.data.weekly is bool)
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && request.resource.data.remind is bool
        && request.resource.data.updatedAt == request.time
        && (!('verified' in request.resource.data) || request.resource.data.verified == false
            || (resource != null && resource.data.get('verified', false) == true && resource.data.email == request.resource.data.email)
            || otpOk(request.resource.data, uid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // verifyReq/{uid}: "onay kodu gönder" isteği (GitHub görevi işler ve siler)
    match /verifyReq/{uid} {
      allow read: if false;
      allow create, update: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.email.size() <= 120
        && request.resource.data.at == request.time;
    }
    // otpStatus/{uid}: kodun gönderildiği adres ve saat (sahibi görür); otp/{uid} hiç okunamaz
    match /otpStatus/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // series/{seriKey}_{uid}: playoff seri tahmini (kazanan + kaç maçta). Serinin ilk maçında kilitlenir.
    match /series/{sid} {
      allow read: if resource == null
        || (signedIn() && resource.data.uid == request.auth.uid)
        || request.time >= resource.data.start;
      function validSeries() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'key', 'winner', 'games', 'start', 'updatedAt'])
          && d.uid == request.auth.uid
          && sid == d.key + '_' + request.auth.uid
          && str(d.key, 40) && str(d.winner, 6)
          && d.games in [4, 5, 6, 7]
          && d.start is timestamp
          && d.updatedAt == request.time
          && request.time < d.start;
      }
      allow create: if isPlayer() && validSeries();
      allow update: if isPlayer() && validSeries()
        && resource.data.uid == request.auth.uid
        && request.resource.data.start == resource.data.start
        && request.time < resource.data.start;
      allow delete: if false;
    }

    // talk/{maçId}_{uid}: maç kartına emoji tepki ve kısa yorum (laf atma). Herkes görür, sahibi yazar.
    match /talk/{tid} {
      allow read: if signedIn();
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'gid', 'day', 'e', 't', 'at'])
        && request.resource.data.uid == request.auth.uid
        && tid == request.resource.data.gid + '_' + request.auth.uid
        && str(request.resource.data.gid, 20) && str(request.resource.data.day, 8)
        && request.resource.data.e in ['', '😂', '🔥', '🤡', '😱', '👏', '💀', '🎯', '🙏']
        && request.resource.data.t is string && request.resource.data.t.size() <= 80
        && !request.resource.data.t.lower().matches('.*(orospu|siktir|sikerim|yarrak|am[iı]nak|amc[iı]k|ibne|pezevenk|fuck|nigg|faggot).*')
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
